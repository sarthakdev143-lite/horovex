# ============================================================================
# KAIROS — Git Ignore Configuration (Next.js + Supabase + Three.js / WebGL)
# ============================================================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing & Coverage
/coverage
/.nyc_output
playwright-report/
test-results/

# Next.js Build & Cache
/.next/
/out/
/build
/dist
next-env.d.ts
*.tsbuildinfo

# Environment Variables & Secrets (Never commit credentials)
.env
.env.*
!.env.example
!.env.template

# Supabase Local Development
supabase/.branches
supabase/.temp
supabase/.env

# Vercel / Deployment
.vercel
.netlify

# Debug & Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# OS & Editor Artifacts
.DS_Store
Thumbs.db
Desktop.ini
*.pem
*.swp
*.swo
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Temporary / Cache Files
.cache/
.turbo/
*.tmp
*.temp

# Agent Workspace & Metadata
.agents/
