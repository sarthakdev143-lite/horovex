# ============================================================================
# KAIROS — Environment Variables Template
# Copy this file to .env.local and fill in your credentials
# ============================================================================

# --- Supabase Configuration ---
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# --- AI Reasoning Engine Provider Keys (Configure at least one) ---
OPENAI_API_KEY="sk-..."
GEMINI_API_KEY="AIza..."
ANTHROPIC_API_KEY="sk-ant-..."

# Default AI Model Selection (e.g., gpt-4o, gemini-2.5-pro, claude-3-7-sonnet-latest)
KAIROS_PRIMARY_MODEL="gpt-4o"

# --- App Runtime Settings ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ENABLE_DEMO_FALLBACK="true"
